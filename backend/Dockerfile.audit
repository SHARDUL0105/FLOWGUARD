# Immutable Audit Log Service Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY backend/requirements-audit.txt /tmp/requirements-audit.txt
RUN pip install --no-cache-dir -r /tmp/requirements-audit.txt

# Copy audit server
COPY backend/audit_server.py /app/audit_server.py

# Create audit data directory
RUN mkdir -p /var/lib/audit

# Expose port
EXPOSE 8080

# Run audit server
CMD ["python", "audit_server.py"]